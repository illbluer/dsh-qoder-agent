{
  "name": "dsh-qoder-agent",
  "displayName": "DSH Qoder Agent",
  "description": "把 Qoder CN 桌面 App 里的模型接入 DeepSeek Harness —— bring Qoder CN desktop app models into DeepSeek Harness with zero configuration.",
  "version": "0.1.0",
  "author": "ILLBLUER",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "qoder",
    "qoder-cn",
    "models",
    "llm",
    "bridge"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illbluer/dsh-qoder-agent.git"
  },
  "homepage": "https://github.com/illbluer/dsh-qoder-agent#readme",
  "bugs": {
    "url": "https://github.com/illbluer/dsh-qoder-agent/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@earendil-works/pi-ai": "^1.1.0"
  }
}
